      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Сколько стоит межкомнатная перегородка?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Готовые модели начинаются от 64 900 ₽ за изделие. Итог зависит от толщины стекла, типа открывания, фурнитуры и декора. Смету менеджер GENGLASS считает после замера."
        }
      },
      {
        "@type": "Question",
        "name": "Можно ли поставить перегородку без сверления пола?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Да. Раздвижную створку вешают на верхнюю направляющую с креплением в потолок или в стену, стационарное полотно заводят в П-образный профиль по стенам."
        }
      },
      {
        "@type": "Question",
        "name": "Какое стекло выбрать для перегородки в квартире?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Закалённое 8 мм - для стационарных полотен и лёгких створок, 10 мм - универсальный вариант для раздвижных систем, 12 мм берут при высоте от 2700 мм."
        }
      },
      {
        "@type": "Question",
        "name": "Сколько дней занимает изготовление и монтаж?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "По индивидуальным размерам - 20-25 дней: замер, чертёж, раскрой, закалка, покраска профиля, сборка и ОТК. Монтаж занимает 1 день, каскадные конструкции - до 2 дней."
        }
      },
      {
        "@type": "Question",
        "name": "Безопасна ли стеклянная перегородка, если в доме дети?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Закалённое стекло при ударе рассыпается на мелкие осколки с тупыми краями. Для детской наклеивают защитную плёнку или ставят триплекс: склеенные стёкла остаются в раме."
        }
      },
      {
        "@type": "Question",
        "name": "Нужно ли согласовывать перегородку в квартире?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Перегородка не опирается на несущие конструкции, поэтому обычно её ставят без перепланировки. Согласование нужно, если меняются границы мокрых зон или закрывается проём в несущей стене."
        }
      }
    ]
  }
]
